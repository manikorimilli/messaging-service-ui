# Copy to .env.local and adjust. Restart `npm run dev` after changing.

# Mock mode is ON unless this is exactly "false".
# Mock mode simulates the backend in the browser. Nothing is sent anywhere.
VITE_USE_MOCK_API=true

# Backend base URL used when VITE_USE_MOCK_API=false. No trailing slash.
# Local:  http://localhost:8080
# Azure:  https://messagin-service-gshecfhwaubth6fk.centralindia-01.azurewebsites.net
VITE_API_BASE_URL=http://localhost:8080

# Optional, dev server only. If the backend blocks browser requests (CORS),
# set VITE_API_BASE_URL to an empty value and point this at the backend.
# Vite then forwards /api/* to it from the same origin.
# DEV_PROXY_TARGET=https://messagin-service-gshecfhwaubth6fk.centralindia-01.azurewebsites.net
