# Copy to .env (cp .env.example .env) and restart npm run dev after any change.

# true: simulated data, no backend needed. false: call the real backend.
VITE_USE_MOCK_API=true

# Backend the dev proxy forwards /api/* to. Keep one line active.
DEV_PROXY_TARGET=http://localhost:8080
